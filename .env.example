# Obelisk конфигурация (env). Скопируйте в .env и заполните.
# Не коммитьте секреты в репозиторий.

# --- Узел ---
OBELISK_NODE_ID=obelisk-1

# --- Порты (control/data для Phantom, web для админки/API) ---
OBELISK_CONTROL_PORT=4455
OBELISK_DATA_PORT=50021
OBELISK_WEB_PORT=8000
# на чём слушать web. Для приваЬой сети оставьте 127.0.0.1.
OBELISK_WEB_BIND=127.0.0.1

# --- Пул портов сессий (постоянный порт на игрока) ---
# Автозаполняется при старте.
OBELISK_PORT_POOL_START=30000
OBELISK_PORT_POOL_END=39999

# --- API машина-машина (Кенни-бэкенд) ---
# Секрет для заголовка X-Service-Key. Сгенерируйте:
#   openssl rand -hex 24
OBELISK_SERVICE_API_KEY=
# CSV IP, с которых разрешён /api/service/* (пусто = любой с верным ключом).
OBELISK_ALLOW_API_PEERS=10.0.0.5,10.0.0.6

# --- Админ-панель ---
OBELISK_ADMIN_USER=admin
OBELISK_ADMIN_PASS=change-me

# --- Лимиты ---
OBELISK_MAX_SESSIONS=500
OBELISK_MAX_PENDING_CLIENTS=100
# Потолок data-пула Phantom на каждый сервер: сколько готовых сокетов от Phantom
# ждут клиента (1-64, по умолчанию 64). Уменьшите, чтобы Phantom держал меньше
# соединений и тратил меньше памяти на простое.
OBELISK_DATA_POOL_MAX=64

# --- Логирование ---
OBELISK_LOG_LEVEL=info
